# ==============================================================================
# KhetGPT Environment Configuration Template
# Copy this file to .env and configure values before starting the backend
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
PORT=8000
SECRET_KEY=khetgpt-secure-random-secret-key-replace-in-production

# LLM API Configuration (Groq Cloud)
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Database Configuration
# Default: persistent SQLite database in data/db/khetgpt.db
# For Production / Render PostgreSQL: postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///./data/db/khetgpt.db

# Vector Database & Multilingual Embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHROMA_PERSIST_DIR=./data/chroma_db

# CORS Allowed Origins (Comma separated or * for dev)
CORS_ORIGINS=*

# Frontend Environment (Vite)
# Production: Set to your live Render backend URL (e.g. https://khetgpt-backend.onrender.com)
VITE_API_URL=http://localhost:8000

